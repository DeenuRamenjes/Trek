{
  "expo": {
    "name": "Trek",
    "slug": "trek",
    "scheme": "trek",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.deenuramenjes.trek",
      "supportsTablet": false,
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.deenuramenjes.trek",
      "adaptiveIcon": {
        "backgroundColor": "#2E7D5B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F7F7F5",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#111214"
          }
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Trek uses Face ID to unlock the app."
        }
      ],
      "expo-sharing",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.deenuramenjes.trek.widget",
          "groupIdentifier": "group.com.deenuramenjes.trek",
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "enableAndroid": false,
          "widgets": [
            {
              "name": "TrekWidget",
              "displayName": "Trek",
              "description": "Today's goals with progress. Tap a goal to mark it done.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "contentMarginsDisabled": false,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": false
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TrekWidget",
              "label": "Trek",
              "description": "Today's goals with progress. Tap a goal to mark it done.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "160dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
